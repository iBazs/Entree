<ui:FluentWindow
    ExtendsContentIntoTitleBar="True"
    Height="760"
    MinHeight="460"
    MinWidth="800"
    Title="Entrée"
    Width="1100"
    WindowBackdropType="Mica"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
    mc:Ignorable="d"
    ui:Design.Background="{ui:ThemeResource LayerFillColorDefaultBrush}"
    ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    x:Class="Entree.MVVM.View.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:view="clr-namespace:Entree.MVVM.View.Pages"
    xmlns:viewmodel="clr-namespace:Entree.MVVM.ViewModel.Control"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ui:NavigationView
            FooterMenuItemsSource="{Binding Path=FooterItems}"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            MenuItemsSource="{Binding Path=MenuItems}"
            OpenPaneLength="180"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar}"
            Width="Auto">
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:NavigationViewContentPresenter
                        x:Name="PageHost"
                        TransitionDuration="0"
                        Content="{Binding NavigationService.CurrentView}"
                        Margin="0,0,0,56"
                        Panel.ZIndex="0" >
                        <ui:NavigationViewContentPresenter.Template>
                            <ControlTemplate TargetType="ui:NavigationViewContentPresenter">
                                <ContentPresenter Margin="{TemplateBinding Padding}" x:Name="PART_FrameCP" />
                            </ControlTemplate>
                        </ui:NavigationViewContentPresenter.Template>
                    </ui:NavigationViewContentPresenter>
                    <view:LogView
                        DataContext="{Binding LogViewModel}"
                        Panel.ZIndex="1"
                        VerticalAlignment="Bottom" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <ui:TitleBar
            Grid.Row="0"
            Title="Entrée"
            x:Name="TitleBar">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/images/entree.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>