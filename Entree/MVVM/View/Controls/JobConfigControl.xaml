<UserControl
    Background="Transparent"
    d:DataContext="{d:DesignInstance Type=viewmodel:JobViewModel}"
    d:DesignWidth="600"
    mc:Ignorable="d"
    x:Class="Entree.MVVM.View.Controls.JobConfigControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Entree.MVVM.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Entree.MVVM.View.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodel="clr-namespace:Entree.MVVM.ViewModel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ui:TextBlock" x:Key="Label">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ui:CardExpander
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        IsExpanded="False"
        Margin="0,0,0,8">

        <ui:CardExpander.Header>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:StatusBadge
                    Icon="{Binding StatusIcon, FallbackValue=Info24}"
                    Margin="0,0,12,0"
                    StatusBackground="{Binding StatusColor, FallbackValue=Grey}"
                    Text="{Binding StatusText, FallbackValue=Status}"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0"
                        Text="{Binding NextRunTime, StringFormat='{}Next run {0:ddd d MMM yyyy, HH:mm}'}"
                        Visibility="{Binding NextRunTimeVisibility}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Grid.Row="0"
                    Margin="0,0,12,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <ui:Button
                        Appearance="{Binding ProgressAppearance, FallbackValue=Secondary}"
                        Command="{Binding RunNowCommand}"
                        Icon="{Binding ProgressIcon, FallbackValue=Info24}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="ui:Button">
                                <Setter Property="ToolTip" Value="Run now" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="ToolTip" Value="Stop" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding DataContext.EditJobCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:TaskView}}}"
                        CommandParameter="{Binding}"
                        Icon="{ui:SymbolIcon Edit24}"
                        Margin="4,0,0,0"
                        ToolTip="Edit task" />
                    <ui:Button
                        Appearance="Transparent"
                        Click="ButtonBase_OnClick"
                        CommandParameter="{Binding}"
                        Icon="{ui:SymbolIcon Delete24}"
                        Margin="4,0,0,0"
                        ToolTip="Delete task" />
                </StackPanel>

                <ProgressBar
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Grid.Row="1"
                    Height="2"
                    IsIndeterminate="True"
                    Margin="0,8,0,0"
                    Visibility="{Binding ProgressVisibility}" />
            </Grid>
        </ui:CardExpander.Header>

        <StackPanel Margin="0,0,0,4">
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource Label}" Text="Repeats" />
                        <ui:TextBlock Margin="0,2,0,0" Text="{Binding ScheduleTypeText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ui:TextBlock Style="{StaticResource Label}" Text="Next run" />
                        <ui:TextBlock
                            Margin="0,2,0,0"
                            Text="{Binding NextRunTime, StringFormat='{}{0:ddd d MMM yyyy, HH:mm}'}"
                            Visibility="{Binding NextRunTimeVisibility}" />
                        <ui:TextBlock
                            Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                            Margin="0,2,0,0"
                            Text="Not scheduled"
                            Visibility="{Binding NoNextRunTimeVisibility}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <ui:TextBlock Style="{StaticResource Label}" Text="Search file" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock
                                Text="{Binding SearchFilePath, TargetNullValue='Not set'}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding SearchFilePath}"
                                VerticalAlignment="Center" />
                            <ui:Button
                                Appearance="Transparent"
                                Command="{Binding OpenSearchFileCommand}"
                                Grid.Column="1"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Margin="8,0,0,0"
                                ToolTip="Show in Explorer" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <StackPanel Visibility="{Binding CommandLine, Converter={StaticResource StringToVisibility}}">
                <ui:TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource Label}"
                    Text="Command" />
                <ui:TextBox
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    IsReadOnly="True"
                    Text="{Binding CommandLine, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ui:CardExpander>
</UserControl>
