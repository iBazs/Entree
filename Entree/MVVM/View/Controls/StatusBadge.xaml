<UserControl
    Background="Transparent"
    mc:Ignorable="d"
    x:Class="Entree.MVVM.View.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{Binding StatusBackground, FallbackValue=Grey, RelativeSource={RelativeSource AncestorType=UserControl}}"
        BorderThickness="0"
        CornerRadius="10"
        Padding="10,3">
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon
                Foreground="White"
                FontSize="14"
                Margin="0,0,4,0"
                Symbol="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                VerticalAlignment="Center"
                Visibility="{Binding Icon, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ui:TextBlock
                FontTypography="Caption"
                Foreground="White"
                HorizontalAlignment="Center"
                Text="{Binding Text, FallbackValue=Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>