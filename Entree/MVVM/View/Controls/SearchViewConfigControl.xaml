<UserControl
    Background="Transparent"
    d:DataContext="{d:DesignInstance Type=viewModel:SearchConfigViewModel}"
    mc:Ignorable="d"
    x:Class="Entree.MVVM.View.Controls.SearchViewConfigControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Entree.MVVM.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Entree.MVVM.View.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModel="clr-namespace:Entree.MVVM.ViewModel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ui:TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ui:TextBlock" x:Key="Value">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ui:TextBlock" x:Key="OptionValue">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style
            BasedOn="{StaticResource DefaultUiButtonStyle}"
            TargetType="ui:Button"
            x:Key="OpenButton">
            <Setter Property="Appearance" Value="Transparent" />
            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
            <Setter Property="Command" Value="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:SearchView}}}" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <ControlTemplate TargetType="ItemsControl" x:Key="ScrollingList">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
    </UserControl.Resources>

    <ui:CardExpander
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        IsExpanded="False"
        Margin="0,0,0,8">

        <ui:CardExpander.Header>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:StatusBadge
                    Margin="0,0,12,0"
                    StatusBackground="{Binding StatusColor}"
                    Text="{Binding CurrentState}"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Text="{Binding SearchDirectory, Converter={StaticResource GetShortPath}}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SearchDirectory}" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibility}}">
                        <ui:TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}  ·  {1}">
                                <Binding Path="SearchForText" />
                                <Binding Converter="{StaticResource DepthLevelConverter}" Path="DepthLevel" />
                            </MultiBinding>
                        </ui:TextBlock.Text>
                    </ui:TextBlock>
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0"
                        Text="{Binding ProgressText}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding CurrentFolder}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding CurrentFolder}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Grid.Row="0"
                    Margin="12,0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Right"
                        Text="Elapsed" />
                    <ui:TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        HorizontalAlignment="Right"
                        Text="{Binding ElapsedTime}"
                        ToolTip="{Binding DetailedTimeInfo}" />
                </StackPanel>

                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding DataContext.CancelSingleSearchCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:SearchView}}}"
                    CommandParameter="{Binding Id}"
                    Grid.Column="3"
                    Grid.Row="0"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Margin="0,0,12,0"
                    ToolTip="Cancel this search"
                    VerticalAlignment="Center"
                    Visibility="{Binding CanBeCancelled, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ProgressBar
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Grid.Row="1"
                    Height="2"
                    IsIndeterminate="{Binding IsRunning}"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </ui:CardExpander.Header>

        <TabControl Margin="0,0,0,4">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,2"
                                    Margin="0,0,4,0"
                                    Padding="12,6"
                                    x:Name="MainBorder">
                                    <ContentPresenter
                                        ContentSource="Header"
                                        TextElement.Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                        x:Name="HeaderText" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" TargetName="MainBorder" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" TargetName="MainBorder" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="TextElement.Foreground" TargetName="HeaderText" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="TextElement.FontWeight" TargetName="HeaderText" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Overview">
                <StackPanel Margin="0,12,0,0">
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <ui:TextBlock
                                FontTypography="BodyStrong"
                                Margin="0,0,0,8"
                                Text="Locations" />

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="Label" Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Style="{StaticResource Label}" Text="Search path" />
                                <ui:TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Value}"
                                    Text="{Binding SearchDirectory}"
                                    ToolTip="{Binding SearchDirectory}" />
                                <ui:Button
                                    CommandParameter="{Binding SearchDirectory}"
                                    Grid.Column="2"
                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                    Style="{StaticResource OpenButton}"
                                    ToolTip="Open in Explorer" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="Label" Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Style="{StaticResource Label}" Text="Save path" />
                                <ui:TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Value}"
                                    Text="{Binding SaveDirectory}"
                                    ToolTip="{Binding SaveDirectory}" />
                                <ui:Button
                                    CommandParameter="{Binding SaveDirectory}"
                                    Grid.Column="2"
                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                    Style="{StaticResource OpenButton}"
                                    ToolTip="Open in Explorer" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="Label" Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Style="{StaticResource Label}" Text="Report" />
                                <ui:TextBlock Grid.Column="1" ToolTip="{Binding FileName}">
                                    <ui:TextBlock.Style>
                                        <Style BasedOn="{StaticResource Value}" TargetType="ui:TextBlock">
                                            <Setter Property="Text" Value="{Binding FileName}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileName}" Value="">
                                                    <Setter Property="Text" Value="No report written yet" />
                                                    <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                                <ui:Button
                                    CommandParameter="{Binding FileName}"
                                    Grid.Column="2"
                                    Icon="{ui:SymbolIcon Open24}"
                                    Style="{StaticResource OpenButton}"
                                    ToolTip="Open report" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Search for" />
                                <ui:TextBlock Margin="0,2,0,0" Text="{Binding SearchForText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Depth" />
                                <ui:TextBlock Margin="0,2,0,0" Text="{Binding DepthLevel, Converter={StaticResource DepthLevelConverter}}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </StackPanel>
            </TabItem>

            <TabItem Header="Options">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card
                        Margin="0,0,6,0"
                        Padding="16"
                        VerticalAlignment="Top">
                        <StackPanel>
                            <ui:TextBlock
                                FontTypography="BodyStrong"
                                Margin="0,0,0,8"
                                Text="Report options" />
                            <Grid Margin="0,4">
                                <ui:TextBlock Text="Include inherited permissions" />
                                <ui:TextBlock Style="{StaticResource OptionValue}" Text="{Binding Inherited, Converter={StaticResource BoolToText}, ConverterParameter='Yes|No'}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <ui:TextBlock Text="Include owners" />
                                <ui:TextBlock Style="{StaticResource OptionValue}" Text="{Binding ShowOwner, Converter={StaticResource BoolToText}, ConverterParameter='Yes|No'}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <ui:TextBlock Text="Access matrix" />
                                <ui:TextBlock Style="{StaticResource OptionValue}" Text="{Binding ShowMatrix, Converter={StaticResource BoolToText}, ConverterParameter='Yes|No'}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <ui:TextBlock Text="Group members" />
                                <ui:TextBlock Style="{StaticResource OptionValue}" Text="{Binding ShowGroups, Converter={StaticResource BoolToText}, ConverterParameter='Yes|No'}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <ui:TextBlock Text="Open report when finished" />
                                <ui:TextBlock Style="{StaticResource OptionValue}" Text="{Binding OpenResult, Converter={StaticResource BoolToText}, ConverterParameter='Yes|No'}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <ui:Card
                            Margin="0,0,0,12"
                            Padding="16"
                            Visibility="{Binding ShowMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="Excluded accounts" />
                                <controls:EmptyState
                                    Icon="PeopleError24"
                                    IconSize="28"
                                    Spacing="0,12"
                                    Title="No excluded accounts"
                                    Visibility="{Binding ExcludedAccounts.Count, Converter={StaticResource ListToVisibility}, ConverterParameter=invert}" />
                                <ItemsControl
                                    ItemsSource="{Binding ExcludedAccounts}"
                                    Margin="0,8,0,0"
                                    MaxHeight="160"
                                    Template="{StaticResource ScrollingList}"
                                    Visibility="{Binding ExcludedAccounts.Count, Converter={StaticResource ListToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:TextBlock
                                                FontTypography="Caption"
                                                Margin="0,2"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="Domains" />
                                <controls:EmptyState
                                    Icon="MapDrive24"
                                    IconSize="28"
                                    Spacing="0,12"
                                    Title="No extra domains"
                                    Visibility="{Binding DomainNames.Count, Converter={StaticResource ListToVisibility}, ConverterParameter=invert}" />
                                <ItemsControl
                                    ItemsSource="{Binding DomainNames}"
                                    Margin="0,8,0,0"
                                    MaxHeight="160"
                                    Template="{StaticResource ScrollingList}"
                                    Visibility="{Binding DomainNames.Count, Converter={StaticResource ListToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:TextBlock
                                                FontTypography="Caption"
                                                Margin="0,2"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </ui:CardExpander>
</UserControl>
