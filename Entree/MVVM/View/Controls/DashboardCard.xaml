<UserControl
    HorizontalAlignment="Stretch"
    d:DesignHeight="120"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Entree.MVVM.View.Controls.DashboardCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Storyboard x:Key="HoverAnimation">
            <DoubleAnimation
                Duration="0:0:0.15"
                Storyboard.TargetName="ChevronShift"
                Storyboard.TargetProperty="X"
                To="4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="UnhoverAnimation">
            <DoubleAnimation
                Duration="0:0:0.15"
                Storyboard.TargetName="ChevronShift"
                Storyboard.TargetProperty="X"
                To="0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Button
        Background="Transparent"
        BorderThickness="0"
        Command="{Binding CardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
        Cursor="Hand"
        FocusVisualStyle="{x:Null}"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Padding="0"
        VerticalContentAlignment="Stretch"
        x:Name="CardButton">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid>
                    <ContentPresenter x:Name="Content" />
                    <Border
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="10"
                        IsHitTestVisible="False"
                        Margin="4"
                        x:Name="FocusRing" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" TargetName="FocusRing" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Opacity" TargetName="Content" Value="0.85" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <Border
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="6"
            MinHeight="88"
            Padding="0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    CornerRadius="8"
                    Height="48"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Width="48">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=#38B000}" Offset="0" />
                            <GradientStop Color="{Binding AccentColorSecondary, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=#008000}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <ui:SymbolIcon
                        FontSize="24"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        Symbol="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        VerticalAlignment="Center" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        TextTrimming="CharacterEllipsis" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0"
                        Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ui:SymbolIcon
                    FontSize="16"
                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    Symbol="ChevronRight24"
                    VerticalAlignment="Center">
                    <ui:SymbolIcon.RenderTransform>
                        <TranslateTransform x:Name="ChevronShift" />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </Grid>
        </Border>
    </Button>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter" SourceName="CardButton">
            <BeginStoryboard Storyboard="{StaticResource HoverAnimation}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave" SourceName="CardButton">
            <BeginStoryboard Storyboard="{StaticResource UnhoverAnimation}" />
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
