<UserControl
    Background="Transparent"
    d:DataContext="{d:DesignInstance Type=viewmodel:CreateConfigViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Entree.MVVM.View.Pages.CreateConfigView"
    x:Name="Control"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Entree.MVVM.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodel="clr-namespace:Entree.MVVM.ViewModel.Control"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        AllowDrop="True"
        DragEnter="UIElement_OnDragEnter"
        DragLeave="UIElement_OnDragLeave"
        DragOver="UIElement_OnDragEnter"
        Drop="UIElement_OnDrop"
        x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Background="{ui:ThemeResource SmokeFillColorDefaultBrush}"
            Grid.RowSpan="3"
            IsHitTestVisible="False"
            Opacity="0"
            Panel.ZIndex="10"
            x:Name="DragDropPanel">
            <Border
                BorderThickness="2"
                CornerRadius="8"
                Margin="24"
                MaxWidth="1200">
                <Border.BorderBrush>
                    <DrawingBrush
                        TileMode="Tile"
                        Viewport="0,0,16,16"
                        ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="{DynamicResource AccentFillColorDefaultBrush}">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,8,8" />
                                        <RectangleGeometry Rect="8,8,8,8" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.BorderBrush>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        FontSize="48"
                        HorizontalAlignment="Center"
                        Symbol="ArrowDownload24" />
                    <ui:TextBlock
                        FontTypography="Subtitle"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Text="Drop to load the configuration" />
                    <ui:TextBlock
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        Text="Entrée configuration files (.entree)" />
                </StackPanel>
            </Border>
        </Border>

        <controls:PageHeader
            Grid.Row="0"
            Subtitle="Choose what to scan and how the report is written"
            Title="Create Config" />

        <Grid
            Grid.Row="1"
            Margin="24,9"
            MaxWidth="1200">
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding ClearAllConfigCommand}"
                    Content="Clear"
                    Icon="{ui:SymbolIcon Eraser24}"
                    ToolTip="Remove every configuration and start over" />
                <Border
                    Background="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                    Height="20"
                    Margin="8,0"
                    Width="1" />
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding LoadToConfigFileCommand}"
                    Content="Load"
                    Icon="{ui:SymbolIcon ArrowImport24}"
                    ToolTip="Load configurations from a file" />
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding SaveToConfigFileCommand}"
                    Content="Save"
                    Icon="{ui:SymbolIcon Save24}"
                    Margin="8,0,0,0"
                    ToolTip="Save these configurations to a file" />
            </StackPanel>
            <ui:Button
                Appearance="{Binding Path=AppAppearance, FallbackValue=Secondary}"
                Command="{Binding StartSearchCommand}"
                Content="{Binding Path=ButtonText, FallbackValue=Start}"
                HorizontalAlignment="Right"
                Icon="{Binding Path=Icon, FallbackValue={ui:SymbolIcon Play24}}"
                ToolTip="{Binding ButtonText, StringFormat='{}{0} all searches'}" />
        </Grid>

        <ui:DynamicScrollViewer
            Grid.Row="2"
            Padding="{StaticResource PageContentMargin}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200">
                <ItemsControl ItemsSource="{Binding SearchConfigs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SearchConfigControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding AddNewConfigCommand}"
                    Content="Add configuration"
                    HorizontalAlignment="Center"
                    Icon="{ui:SymbolIcon Add24}"
                    Margin="0,4,0,0"
                    ToolTip="Add another folder to scan in this run"
                    Visibility="{Binding SearchConfigs.Count, Converter={StaticResource ListToVisibility}}" />
                <controls:EmptyState
                    Icon="TextBulletListSquareEdit24"
                    Message="Add a configuration for each folder or share to scan, or load a saved .entree file."
                    Title="No configurations yet"
                    Visibility="{Binding SearchConfigs.Count, Converter={StaticResource ListToVisibility}, ConverterParameter=invert}">
                    <controls:EmptyState.Action>
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding AddNewConfigCommand}"
                            Content="Add configuration"
                            Icon="{ui:SymbolIcon Add24}" />
                    </controls:EmptyState.Action>
                </controls:EmptyState>
            </StackPanel>
        </ui:DynamicScrollViewer>
    </Grid>
</UserControl>
