<UserControl
    Background="Transparent"
    d:DataContext="{d:DesignInstance Type=viewModel:SearchViewModel}"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Entree.MVVM.View.Pages.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Entree.MVVM.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModel="clr-namespace:Entree.MVVM.ViewModel.Control"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        MaxWidth="1200"
        x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Grid.Row="0"
            Subtitle="Queued, running and finished searches"
            Title="Searches" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Margin="24,9"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Secondary"
                Command="{Binding ClearConfigsCommand}"
                Content="Clear list"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="Remove every finished search from this list" />
            <ui:Button
                Appearance="Danger"
                Command="{Binding CancelAllSearchCommand}"
                Content="Cancel all"
                Icon="{ui:SymbolIcon DismissSquareMultiple20}"
                IsEnabled="{Binding IsRunning}"
                Margin="8,0,0,0"
                ToolTip="Cancel every running search" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            Padding="{StaticResource PageContentMargin}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding SearchConfigs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SearchViewConfigControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:EmptyState
                    Icon="DocumentSearch24"
                    Message="Create a search configuration and start it to see its progress here."
                    Title="No searches yet"
                    Visibility="{Binding SearchConfigs.Count, Converter={StaticResource ListToVisibility}, ConverterParameter=invert}">
                    <controls:EmptyState.Action>
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding NewSearchCommand}"
                            Content="New search"
                            Icon="{ui:SymbolIcon Add24}" />
                    </controls:EmptyState.Action>
                </controls:EmptyState>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
